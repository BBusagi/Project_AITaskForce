<Window x:Class="AssetDesk.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AssetDesk · Windows 文件与应用管理" Width="1380" Height="900" MinWidth="1100" MinHeight="760" WindowStartupLocation="CenterScreen" Background="#F3F6FA" Closing="Window_Closing">
  <Grid Background="#F3F6FA">
    <Grid.ColumnDefinitions><ColumnDefinition Width="218" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="#142238" Padding="18,28">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="10,0,0,32"><TextBlock Text="AssetDesk" FontSize="27" FontWeight="Bold" Foreground="White" /><TextBlock Text="Windows 文件与应用" Foreground="#9CACBF" Margin="0,8,0,0" /></StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="10,20,0,0"><TextBlock Text="v0.1.7" Foreground="#B7C6D9" /><TextBlock Text="索引保存在本机" FontSize="11" Foreground="#8CA2BD" Margin="0,5,0,0" /></StackPanel>
        <ListBox x:Name="Navigation" Background="Transparent" BorderThickness="0" Foreground="#BDCBDE" SelectionChanged="Navigation_SelectionChanged">
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="16,14" /><Setter Property="Margin" Value="0,3" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="NavBorder" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#2B4163" /><Setter Property="Foreground" Value="White" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#243650" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
          <ListBoxItem Content="◈   总览" /><ListBoxItem Content="✦   AI 分析" /><ListBoxItem Content="◷   扫描与记录" /><ListBoxItem Content="▦   应用清单" /><ListBoxItem Content="▤   文件资产" /><ListBoxItem Content="⌘   个人化面板" /><ListBoxItem Content="⚙   设置" />
        </ListBox>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="30,26,30,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel><TextBlock x:Name="PageTitle" Text="资产总览" FontSize="27" FontWeight="Bold" /><TextBlock x:Name="PageSubtitle" Text="已索引的应用、文件、项目和环境。" Foreground="{StaticResource Muted}" Margin="0,7,0,0" /></StackPanel>
        <Border Grid.Column="1" Background="#E5F0EB" CornerRadius="20" Padding="14,8" VerticalAlignment="Top"><TextBlock Text="●  本地索引" Foreground="#287759" FontSize="12" /></Border>
      </Grid>
      <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="12" Margin="0,0,0,20">
        <StackPanel><WrapPanel Margin="0,0,0,12">
          <TextBlock Text="检索范围" VerticalAlignment="Center" Margin="4,0,10,0" />
          <ComboBox x:Name="ScanModeCombo" Width="155" SelectedIndex="0" SelectionChanged="ScanMode_Changed" Padding="8" Margin="0,0,12,0"><ComboBoxItem Content="全电脑检索" /><ComboBoxItem Content="按磁盘检索" /><ComboBoxItem Content="指定目录（已有）" /></ComboBox>
          <ComboBox x:Name="DiskCombo" DropDownOpened="Disk_DropDownOpened" Width="230" DisplayMemberPath="Label" Visibility="Collapsed" Padding="8" Margin="0,0,12,0" />
          <Button Content="预扫描" x:Name="PreScanButton" Click="PreScan_Click" ToolTip="只统计当前可枚举的文件／项目数量，按枚举耗时粗估后续扫描时间；不写入资产索引。" />
          <Button x:Name="ScanButton" Content="检索（优先缓存）" Style="{StaticResource Primary}" Click="Scan_Click" />
          <CheckBox x:Name="ForceScanBox" Content="强制刷新扫描" VerticalAlignment="Center" Margin="4,0,16,0" ToolTip="默认复用旧快照，不复查磁盘变化；勾选后重新枚举所选范围。" />
          <TextBlock Text="快照可能过期 · 扫描不设固定数量上限" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="11" />
        </WrapPanel><DockPanel>
          <Button x:Name="DiscoverButton" Content="刷新应用与环境" Click="Discover_Click" DockPanel.Dock="Right" />
          <Button x:Name="PauseButton" Content="暂停" Click="Pause_Click" IsEnabled="False" DockPanel.Dock="Right" />
          <Button x:Name="CancelButton" Content="取消任务" Click="Cancel_Click" IsEnabled="False" DockPanel.Dock="Right" />
          <TextBlock x:Name="SearchLabel" Visibility="Collapsed" Text="搜索" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="4,0,10,0" />
          <TextBox x:Name="SearchBox" Visibility="Collapsed" TextChanged="Search_TextChanged" ToolTip="按名称、路径、分类或标签筛选（元数据搜索）" MinWidth="160" Margin="0,0,12,0" />
        </DockPanel></StackPanel>
      </Border>
      <Grid Grid.Row="2">
        <ScrollViewer x:Name="OverviewPanel" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <UniformGrid Columns="4" Margin="0,0,0,20">
              <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="已索引资产" Foreground="{StaticResource Muted}" /><TextBlock x:Name="AssetCount" Text="0" FontSize="30" FontWeight="Bold" Margin="0,12,0,0" /></StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="文件逻辑大小" Foreground="{StaticResource Muted}" /><TextBlock x:Name="SizeCount" Text="0 B" FontSize="30" FontWeight="Bold" Margin="0,12,0,0" /></StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="项目 / 环境" Foreground="{StaticResource Muted}" /><TextBlock x:Name="ProjectCount" Text="0 / 0" FontSize="30" FontWeight="Bold" Margin="0,12,0,0" /></StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="应用记录" Foreground="{StaticResource Muted}" /><TextBlock x:Name="AppCount" Text="0" FontSize="30" FontWeight="Bold" Margin="0,12,0,0" Foreground="{StaticResource Accent}" /></StackPanel></Border>
            </UniformGrid>
            <Border Background="White" CornerRadius="12" Padding="24" Margin="0,0,0,20">
              <StackPanel><TextBlock Text="浏览" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="选择应用、文件或项目查看详情并修改分类。" Foreground="{StaticResource Muted}" Margin="0,10,0,16" /><WrapPanel><Button Content="应用清单" Style="{StaticResource Primary}" Click="GoApps_Click" /><Button Content="文件资产" Click="GoFiles_Click" /><Button Content="个人化面板" Click="GoPersonal_Click" /><Button x:Name="DemoButton" Content="载入示例数据" Click="Demo_Click" /></WrapPanel></StackPanel>
            </Border>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}" Margin="0,0,16,0"><StackPanel><TextBlock Text="资产分布" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,16" /><ItemsControl x:Name="CategoryList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E8EDF4" BorderThickness="0,0,0,1" Padding="0,10"><TextBlock Text="{Binding}" /></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="交叉标签不重复计入资产总数；逻辑大小不是可释放空间。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,15,0,0" /></StackPanel></Border>
              <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="索引状态" FontSize="17" FontWeight="SemiBold" /><TextBlock x:Name="OverviewIndexHint" Text="尚无扫描记录。" Foreground="{StaticResource Muted}" Margin="0,18,0,16" /><Button Content="查看扫描记录" Click="GoHistory_Click" HorizontalAlignment="Left" /><TextBlock Text="分类和标签保存在索引中，文件位置不变。" Foreground="{StaticResource Muted}" Margin="0,18,0,0" /><TextBlock Text="AI 分析已暂停。" Foreground="{StaticResource Muted}" Margin="0,12,0,0" /></StackPanel></Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>
        <Grid x:Name="AssetsPanel" Visibility="Collapsed">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,16,0"><Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <WrapPanel x:Name="AppViewControls" Margin="18,16,18,0" Visibility="Collapsed">
              <ComboBox x:Name="AppViewCombo" Width="130" SelectedIndex="0" SelectionChanged="AppView_Changed" Padding="8" Margin="0,0,16,0"><ComboBoxItem Content="列表视图" /><ComboBoxItem Content="图标视图" /></ComboBox>
              <CheckBox x:Name="ShowSystemAppsBox" Content="显示系统相关应用" IsChecked="True" Checked="AppView_Changed" Unchecked="AppView_Changed" VerticalAlignment="Center" />
            </WrapPanel>
            <TextBlock Grid.Row="1" x:Name="ListHint" Margin="18" Foreground="{StaticResource Muted}" />
            <DataGrid Grid.Row="2" x:Name="AssetGrid" SelectionChanged="AssetGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" MinWidth="180" /><DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="65" /><DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="110" /><DataGridTextColumn Header="大小 / 版本" Binding="{Binding InventoryText}" Width="95" /><DataGridTextColumn x:Name="AppSystemColumn" Header="系统关联" Binding="{Binding SystemText}" Width="100" Visibility="Collapsed" /></DataGrid.Columns></DataGrid>
            <ListBox Grid.Row="2" x:Name="AppIconList" Visibility="Collapsed" SelectionMode="Extended" SelectionChanged="AssetGrid_SelectionChanged" BorderThickness="0" Background="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="12">
              <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
              <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10" /><Setter Property="Margin" Value="4" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate><DataTemplate><StackPanel Width="120" ToolTip="{Binding Evidence}">
                <Grid Width="52" Height="52" Margin="0,0,0,10"><Border Background="#EDF2FA" CornerRadius="12"><TextBlock Text="▦" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#65748B" /></Border><Image Source="{Binding Converter={StaticResource AppIcon}}" Stretch="Uniform" /></Grid>
                <TextBlock Text="{Binding Name}" TextAlignment="Center" Height="42" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Version}" TextAlignment="Center" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <TextBlock Text="{Binding SystemText}" TextAlignment="Center" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
              </StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </Grid></Border>
          <Border Grid.Column="1" Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="资产详情" FontSize="17" FontWeight="SemiBold" /><TextBlock x:Name="DetailName" Text="选择一个资产" FontSize="18" FontWeight="Bold" Margin="0,22,0,12" /><TextBlock Text="位置 / 来源标识" Foreground="{StaticResource Muted}" FontSize="11" /><TextBox x:Name="DetailPath" IsReadOnly="True" TextWrapping="Wrap" Margin="0,6,0,15" /><TextBlock x:Name="DetailEvidence" Foreground="{StaticResource Muted}" /><TextBlock x:Name="DetailProtection" Margin="0,15" Foreground="#927031" /><TextBlock Text="分类（人工覆盖）" /><TextBox x:Name="ManualCategory" Margin="0,6,0,12" /><TextBlock Text="标签（逗号分隔）" /><TextBox x:Name="ManualTags" Margin="0,6,0,16" /><Button x:Name="SaveTagButton" Content="保存分类与标签" Style="{StaticResource Primary}" Click="SaveTags_Click" Margin="0,0,0,10" /><Button Content="定位原始目录" Click="Locate_Click" Margin="0,0,0,10" /><Button Content="查看 AI 分析（已冻结） →" Click="GoAi_Click" Margin="0,0,0,12" /><TextBlock Text="此处修改仅保存分类和标签。" FontSize="11" Foreground="{StaticResource Muted}" /></StackPanel></ScrollViewer></Border>
        </Grid>
        <Grid x:Name="AiPanel" Visibility="Collapsed" IsEnabled="False">
          <Grid.ColumnDefinitions><ColumnDefinition Width="340" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" Margin="0,0,16,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock Text="你希望怎样整理？" FontSize="18" FontWeight="SemiBold" /><TextBox x:Name="GoalBox" Text="按工作、学习、个人资料粗分类，为项目和开发环境添加易懂的标签；不确定的对象请说明需要我检查什么。" AcceptsReturn="True" TextWrapping="Wrap" Height="120" VerticalContentAlignment="Top" Margin="0,14,0,14" MaxLength="2000" TextChanged="Goal_Changed" />
            <TextBlock Text="步骤 1 · 确认本次范围" FontWeight="SemiBold" /><TextBlock Text="优先使用资产列表里的多选项；未选择时使用全局搜索匹配的前 40 项。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,12" /><Button Content="生成发送预览" Click="Preview_Click" Margin="0,0,0,8" /><TextBlock x:Name="ContextHint" Text="尚未准备资产摘要" Foreground="{StaticResource Accent}" Margin="0,0,0,10" /><TextBox x:Name="ContextPreview" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Height="185" FontFamily="Consolas" FontSize="11" />
            <TextBlock Text="步骤 2 · 交给所选 AI" FontWeight="SemiBold" Margin="0,18,0,8" /><CheckBox x:Name="ForceAnalysisBox" Content="重新分析（跳过缓存，调用模型）" Checked="AnalysisCacheMode_Changed" Unchecked="AnalysisCacheMode_Changed" Margin="0,0,0,10" /><TextBlock x:Name="AnalysisCacheHint" Text="先生成预览，再检查缓存。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,10" /><Button x:Name="AnalyzeButton" Content="确认发送 / 复用分析缓存" Style="{StaticResource Primary}" Click="Analyze_Click" IsEnabled="False" Margin="0,0,0,12" /><TextBlock Text="仅发送预览中的元数据和整理目标，不含完整路径和正文。选择 API 服务商时，这些信息将发送到下方服务地址。" Foreground="{StaticResource Muted}" FontSize="11" /><TextBlock x:Name="AiRoute" Margin="0,10,0,0" Foreground="{StaticResource Muted}" FontSize="11" />
          </StackPanel></ScrollViewer></Border>
          <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="AI 的整理建议" FontSize="18" FontWeight="SemiBold" /><TextBlock x:Name="AiSummary" Text="连接模型并生成建议后，在这里查看说明。所有建议先进入待审核，不会自动应用。" Margin="0,10,0,0" Foreground="{StaticResource Muted}" MaxHeight="140" /></StackPanel></Border>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><DataGrid x:Name="SuggestionGrid" SelectionChanged="SuggestionGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="对象" Binding="{Binding AssetName}" Width="*" MinWidth="150" /><DataGridTextColumn Header="建议分类" Binding="{Binding Category}" Width="110" /><DataGridTextColumn Header="标签" Binding="{Binding TagText}" Width="*" MinWidth="130" /><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80" /></DataGrid.Columns></DataGrid><TextBlock x:Name="SuggestionReason" Grid.Row="1" Text="选择建议查看模型理由。" Margin="18" Foreground="{StaticResource Muted}" MaxHeight="110" /></Grid></Border>
            <StackPanel Grid.Row="2" Margin="0,16,0,0"><WrapPanel><Button x:Name="AcceptButton" Content="接受所选分类" Style="{StaticResource Primary}" Click="Accept_Click" /><Button x:Name="RejectButton" Content="拒绝所选建议" Click="Reject_Click" /></WrapPanel><TextBlock Text="接受仅更新工作台分类和标签，原始文件与保护状态不变。" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,10,0,0" /></StackPanel>
          </Grid>
        </Grid>
        <Border x:Name="HistoryPanel" Visibility="Collapsed" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Text="扫描覆盖与局部错误" FontSize="18" FontWeight="SemiBold" /><TextBlock Grid.Row="1" Text="记录支持鼠标选中、Ctrl+A、Ctrl+C 与右键复制。预扫描统计当前可枚举对象并粗估耗时；正式扫描不设固定数量上限。旧达限记录仍为历史部分扫描。" Foreground="{StaticResource Muted}" Margin="0,12,0,16" /><TextBox Grid.Row="2" x:Name="HistoryText" Text="尚无扫描记录。" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft YaHei" FontSize="12" VerticalContentAlignment="Top" /></Grid></Border>
        <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Width="760" HorizontalAlignment="Left">
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="AI 服务设置" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="选择服务商，填写 API Key，然后应用设置。官方服务地址和初始模型自动填入。" Foreground="{StaticResource Muted}" Margin="0,12,0,18" />
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <TextBlock Text="服务商" Margin="0,0,0,7" /><TextBlock Grid.Column="1" Text="API Key" Margin="0,0,0,7" />
              <ComboBox x:Name="ProviderCombo" Grid.Row="1" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Provider_Changed" Padding="8" Margin="0,0,12,0" />
              <PasswordBox x:Name="ApiKeyBox" Grid.Row="1" Grid.Column="1" Padding="10,8" BorderBrush="#D8E1EE" Margin="0,0,12,0" MaxLength="4096" />
              <Button x:Name="SaveSettingsButton" Grid.Row="1" Grid.Column="2" Content="应用设置" Style="{StaticResource Primary}" Click="SaveSettings_Click" Margin="0" />
            </Grid>
            <TextBlock x:Name="KeyHint" Foreground="{StaticResource Muted}" Margin="0,12,0,14" FontSize="12" />
            <Expander Header="高级设置 · 服务地址与模型" Margin="0,0,0,14"><StackPanel Margin="0,12,0,0"><TextBlock Text="API Base URL" /><TextBox x:Name="EndpointBox" Margin="0,6,0,12" /><TextBlock Text="模型名称（按账户可用模型调整）" /><TextBox x:Name="ModelBox" Margin="0,6,0,12" /><CheckBox x:Name="RemoveKeyBox" Content="应用时移除当前服务商已保存的密钥" /></StackPanel></Expander>
            <Button x:Name="ConnectButton" Content="检查连接 / 列出模型" Click="Connect_Click" HorizontalAlignment="Left" />
            <TextBlock x:Name="ModelStatus" Foreground="{StaticResource Muted}" Margin="0,16,0,0" />
          </StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><TextBlock Text="缓存管理" FontSize="18" FontWeight="SemiBold" /><TextBlock x:Name="CacheSummary" Foreground="{StaticResource Muted}" Margin="0,14,0,16" /><Button x:Name="ClearCacheButton" Content="仅清除扫描与 AI 缓存" Click="ClearCache_Click" HorizontalAlignment="Left" /></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><TextBlock Text="索引与隐私" FontSize="18" FontWeight="SemiBold" /><TextBlock x:Name="StorageText" Margin="0,16,0,0" Foreground="{StaticResource Muted}" /><TextBlock Text="API Key 使用 Windows 当前账户加密保存，不显示在发送预览中。切换服务商不会带入其他服务商的密钥。" Margin="0,14,0,0" Foreground="{StaticResource Muted}" /><TextBlock Text="正式扫描不设固定数量上限，全电脑检索逐盘进行；实际受可用内存、磁盘和权限限制。依赖目录、连接及离线占位文件默认跳过。完成或取消后保存；旧条目保留为历史发现。" Margin="0,14,0,0" Foreground="{StaticResource Muted}" /><TextBlock Text="当前不提供文件移动、删除或卸载。AI 分析已暂停，连接配置仍可保存。" Margin="0,14,0,20" Foreground="{StaticResource Muted}" /><Button x:Name="ClearButton" Content="清空本地索引与标签…" Click="Clear_Click" HorizontalAlignment="Left" /></StackPanel></Border>
        </StackPanel></ScrollViewer>
      </Grid>
      <TextBlock Grid.Row="3" x:Name="StatusText" Text="就绪 · 选择扫描范围。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,18,0,0" MaxHeight="48" />
    </Grid>
  </Grid>
</Window>
